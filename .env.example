# Server
PORT=3030
NODE_ENV=production

# DimRia (dom.ria.com) — commercial rent data
# Get your key at https://developers.ria.com/
# Required for real rent data. App starts without it, but /analysis/analyze
# will return 503 DimRia [unavailable]: DIM_RIA_API_KEY is not configured.
DIM_RIA_API_KEY=your_dimria_api_key_here

# --- constants kept in code, not configurable via env ---
# REQUEST_TIMEOUT_MS=8000   (wall-clock timeout per external HTTP request)
# CSV output: test-statistic.csv in the working directory
